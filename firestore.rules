rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAccountOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // Backend quota counters must never be writable by clients.
    match /_aiRateLimits/{uid} {
      allow read, write: if false;
    }
    match /users/{uid} {
      allow read, write: if isAccountOwner(uid);
      match /{document=**} {
        allow read, write: if isAccountOwner(uid);
      }
    }
  }
}
